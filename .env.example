# =====================================================================
# Festival Navi 全国文化祭アンケート  環境変数サンプル
# ---------------------------------------------------------------------
# このファイルを .env にコピーして値を設定してください。
#   cp .env.example .env   （PowerShell: Copy-Item .env.example .env）
#
# 値が未設定でもアプリは「デモモード」で起動します（DBに保存されません）。
# 本番でアンケートを保存するには、Supabaseの値を設定してください。
# =====================================================================

# Supabase プロジェクトの URL（例: https://xxxxxxxx.supabase.co）
VITE_SUPABASE_URL=

# Supabase の anon / publishable キー（公開用。ブラウザに露出してOK）
# ※ service_role / secret キーは絶対にここへ書かないでください。
VITE_SUPABASE_ANON_KEY=

# 任意: サイトの公開URL（OGP・canonical・共有リンクに使用）。
# 未設定なら実行中のオリジンを使います。
VITE_SITE_URL=
